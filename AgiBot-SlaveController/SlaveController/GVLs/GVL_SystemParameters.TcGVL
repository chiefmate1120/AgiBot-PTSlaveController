<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.11">
  <GVL Name="GVL_SystemParameters" Id="{6ebbff17-e303-4344-870e-d2871229e24f}">
    <Declaration><![CDATA[VAR_GLOBAL CONSTANT
		
	g_SWVersion : STRING := 'PT(1.4.2.1)';
	
	g_mArmNum :INT := 2;	
	g_mJntNum :INT := 7;	
	g_sArmNum :INT := 4;	
	g_sJntNum :INT := 8;
	g_setupJntNum :INT :=5;
	g_cartDofs :INT :=6;
	g_cartJntNum:INT :=8;
	
	
	
	// control loop interval for each task
	g_slaveArmCtrlCycleTime :LREAL :=0.00025;
	g_slaveArmCtrlFreq :LREAL :=1.0/g_slaveArmCtrlCycleTime;
	g_armDynamicCycleTime :LREAL := 0.001;
	g_armDynamicFreq :LREAL := 1.0/g_armDynamicCycleTime;
	g_setupArmCtrlCycleTime :LREAL := 0.00025;
	g_setupArmCtrlFreq :LREAL := 1.0/g_setupArmCtrlCycleTime;
	g_cartCtrlCycleTime :LREAL := 0.001;
	g_cartCtrlFreq :LREAL := 1.0/g_cartCtrlCycleTime;
	g_safetyCheckCycleTime :LREAL := 0.001;
	
	// wait time before robot init  for ethercat to stablize 
	g_robotInitWaitTime : LREAL := 2.0;
	g_robotSafetyCheckWaitTime : LREAL :=3.0;
	g_robotSafetyDriveOPWaitTime : LREAL :=5.0;
	g_robotSafetyReadFileWaitTime : LREAL :=3.0;
	
	//hardware version information
	g_cartJointParametersVer : STRING := 'Ver1';
	g_slaveArmJointParametersVer : STRING :='Ver1';
	g_setupArmJointParametersVer :STRING :='Ver1';
	g_systemArmJointPara : ST_systemJointParameters;
	
	//recipe
	RecipeDefinitionName :ARRAY [1..12] OF STRING := ['arm1LinkEncValue', 'arm2LinkEncValue', 'arm3LinkEncValue', 'arm4LinkEncValue',
													'Arm1Dynamics','Arm2Dynamics','Arm3Dynamics','Arm4Dynamics',
													'Arm1KineCali', 'Arm2KineCali', 'Arm3KineCali', 'Arm4KineCali'];
	RecipeDefinitionNameCart : STRING := 'SlaveCartEncValue';
	RecipeDefinitionNameMotorPara : STRING := 'SlaveMotorParaVersion';
	RecipeDefinitionNameRecordParam : STRING := 'RecordParameters';
	
	RecipeDefinitionNameScope : STRING := 'EndoscopeParameters';
	
	//device NetID  and device box addr
	g_deviceName : ARRAY [1..6] OF T_MaxString:=['SlaveArm1','SlaveArm2','SlaveArm3','SlaveArm4','Cart','MSCommunication'];
	g_armDeviceJntName : ARRAY [1..13] OF T_MaxString:=['SetupJoint12','SetupJoint12','SetupJoint3','SetupJoint45','SetupJoint45','SlaveJoint1','SlaveJoint2','SlaveJoint3','SlaveJoint45','SlaveJoint45','SlaveJoint678','SlaveJoint678','SlaveJoint678'];
	g_cartDeviceJntName : ARRAY [1..8] OF T_MaxString:=['CartJoint5','CartJoint3','CartJoint4','CartJoint1','CartJoint2','CartJoint6','CartJoint7','CartJoint8'];
END_VAR

VAR_GLOBAL
	//slave arms and setup arms NetId
	g_slaveArmNetID: ARRAY[1..4] OF T_AmsNetId;
	
	//cart device NetId
	g_slaveCartNetID: T_AmsNetId;
	
	//MSCommunication device NetId
	g_slaveMSComNetID: T_AmsNetId;
	
	//slave joint EtherCAT addr
	g_setupJointNetPort:ARRAY[1..g_sArmNum,1..g_setupJntNum] OF UINT;
	
	//slave joint EtherCAT addr
	g_slaveJointNetPort:ARRAY[1..g_sArmNum,1..g_sJntNum] OF UINT;
	
	//cart joint EtherCAT addr
	g_cartJointNetPort :ARRAY[1..g_sJntNum] OF UINT;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>