												  -0.0013625687, -0.000014009052,              0, -0.00026683964];
g_slaveArm3DHErr:ARRAY[1..8,1..4] OF LREAL :=[             0,              0,  -0.021395621,              0,
												 0.00089194356,  -0.0086652144,  0.0028866447,    0.010868572,
												 0.00033165484,              0,    -2.8158404,              0,
												  0.0062565069,              0,     2.8443943,              0,
												 -0.0018300615, -0.00059991967,  0.0035302658, -0.00095159892,
												  0.0022195289,  -0.0031377543,   0.021633127,   0.0019844221,
