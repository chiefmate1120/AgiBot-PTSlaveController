												   -0.0010455737, -0.00034767921,   0.032466545,   0.00077501001,
												    0.0033628312,  -0.0022688458, -0.0044587098,   0.00057326022,
												 -0.000072813946, 0.000080716254,  0.0089639701,    0.0013609391,
												     0.013077489,   0.0015063046,             0, -0.000039429412];
