      <LineId Id="317" Count="0" />
    </LineIds>
    <LineIds Name="FB_SlaveCTControl.run">
      <LineId Id="1286" Count="20" />
      <LineId Id="1201" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>